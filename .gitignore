# Rust
/target/
**/*.rs.bk

# 编辑器
.vscode/
.idea/
*.swp

# 系统
Thumbs.db
.DS_Store

# ---- 密钥 ----
# .env 里有 API key，绝不入库
/.env

# ---- 运行产物 ----
/logs/
/saves/

# ---- 视频精读的派生素材（约 300MB，不入库）----
# 需要重现时按 docs/02 的流程从原视频重新截帧。
# 注意只忽略派生帧，不忽略 docs/_video 下的脚本与 OCR 文本。
/docs/_video/frames/
/docs/_video/ocr_frames/
/frames/
/frames2/
/framesB/
/groups/
/strips/
/_ref/

# Natural Earth / DEM 原始数据缓存（只在重新生成地图资产时需要，产物已入库）
/tools/mapgen/_geo/

# 截图验证产物（node tools/shot.js 生成，不入库）
/tools/_shots/

# Release 打包产物（tools/package.ps1 生成，上传到 GitHub Release，不入库）
/dist/


# ---- 安卓构建产物 ----
# .so 由 tools/build-android.ps1 从 Rust 编出来再拷进 jniLibs，不入库。
/android/app/src/main/jniLibs/
# wry 的 build.rs 生成的 Kotlin 胶水（WryActivity / RustWebView …），
# 每次构建自动重写；只保留我们自己写的 MainActivity.kt。
/android/app/src/main/kotlin/com/ironmind/steelheart/Ipc.kt
/android/app/src/main/kotlin/com/ironmind/steelheart/Logger.kt
/android/app/src/main/kotlin/com/ironmind/steelheart/PermissionHelper.kt
/android/app/src/main/kotlin/com/ironmind/steelheart/Rust.kt
/android/app/src/main/kotlin/com/ironmind/steelheart/RustWebChromeClient.kt
/android/app/src/main/kotlin/com/ironmind/steelheart/RustWebView.kt
/android/app/src/main/kotlin/com/ironmind/steelheart/RustWebViewClient.kt
/android/app/src/main/kotlin/com/ironmind/steelheart/WryActivity.kt
/android/app/src/main/kotlin/com/ironmind/steelheart/proguard-wry.pro
/android/.gradle/
/android/.idea/
/android/build/
/android/app/build/
/android/local.properties
/android/.cxx/
