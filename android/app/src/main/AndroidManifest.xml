<?xml version="1.0" encoding="utf-8"?>
<!--
  钢心 / Iron Mind —— 安卓清单。

  两件必须写对的事：
  1. `usesCleartextTraffic=true`：页面和内核对的是 `http://127.0.0.1:<port>`。
     Android 9+ 默认禁明文 HTTP，不开这个开关 WebView 会直接白屏。
  2. `INTERNET` 权限：内核在**同一个进程**里调大模型 API，不是 WebView 调的。

  configChanges 那一长串不是抄来的：旋转屏幕/切分屏时如果 Activity 被重建，
  内核（连同正在跑的战役）会被重启，玩家会看到"转个屏进度没了"。

  为什么是**启动即横屏**（sensorLandscape）：横屏宽度够把地图和电报台并排放，
  这是这个游戏最舒服的形态（看地图 → 发电报，不用来回开抽屉）。
  更关键的是它能绕开一个坑：外壳声明了 configChanges 不重建 Activity，
  但 tao/wry 这版**不会**在旋转后重新排版 WebView —— 竖屏启动再转横屏，
  2400×1080 的屏幕上页面仍按竖屏 393 CSS px 渲染，右半屏全空。
  一开始就用横屏创建窗口，WebView 首次布局就是 873×393，不需要重排。
  （想支持"运行中旋转"，得在外壳里转发配置变化，那是有风险的独立任务。）
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:theme="@style/Theme.AppCompat.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|density|uiMode|navigation|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
